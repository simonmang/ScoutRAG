SCOUTRAG_ENVIRONMENT=development
SCOUTRAG_LOG_LEVEL=INFO
SCOUTRAG_API_PREFIX=/api/v1
SCOUTRAG_DEFAULT_RESULT_COUNT=10
SCOUTRAG_MAX_RESULT_COUNT=50
SCOUTRAG_CANDIDATE_POOL_SIZE=40
SCOUTRAG_PROFILES_PATH=data/processed/scouting-2025-2026/combined/player_season_profiles.parquet
SCOUTRAG_METRIC_EVIDENCE_PATH=data/processed/scouting-2025-2026/combined/player_metric_evidence.parquet
SCOUTRAG_DENSE_INDEX_PATH=data/processed/scouting-2025-2026/combined/dense_index.json
SCOUTRAG_HISTORY_PATH=data/processed/scouting-history-2024-2026
SCOUTRAG_DENSE_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SCOUTRAG_ENABLE_DENSE_RETRIEVAL=true
SCOUTRAG_LOCAL_FILES_ONLY=false
SCOUTRAG_ANSWER_MODE=template
SCOUTRAG_OPENAI_MODEL=gpt-5.6-luna
SCOUTRAG_OPENAI_MAX_OUTPUT_TOKENS=800
# Required only when SCOUTRAG_ANSWER_MODE=openai:
OPENAI_API_KEY=HIER_DEINEN_API_KEY_EINFUEGEN
# Required to generate any real player data (free or paid API-Football/API-Sports plan):
API_FOOTBALL_KEY=HIER_DEINEN_API_FOOTBALL_KEY_EINFUEGEN
